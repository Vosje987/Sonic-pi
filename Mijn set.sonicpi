#-- Sonic Pi Set v1
#-- meta {"current":2,"zooms":[-4,-3,-3,2,2,2,2,2,2,2]}
#-- buffer 0
#To-DO
#Laatste 3 melodies niet door elkaar --> een melodie stoppen of verwijderen
#Nieuw liedje starten --> andere genre/stijl/sfeer
#-- buffer 1
#main

use_synth :hollow
with_fx :reverb, mix: 0.7 do
  
  play choose([:D4,:E4]), attack: 4, release: 4, amp: 1.4
  sleep 6
  
  
  play choose([:Fs4,:G4]), attack: 2, release: 4, amp: 1.4
  sleep 6
  
  
  play choose([:A4, :Cs5]), attack: 3, release: 3, amp: 1.4
  sleep 7
  
end




live_loop :drums do
  sample :drum_tom_mid_hard, amp: 0.6
  sleep 1
  sample :drum_snare_hard, amp: 0.6
  sleep 1
  sample :drum_tom_mid_hard, amp: 0.6
  sleep 1
  sample :drum_snare_hard, amp: 0.6
  sleep 1
end


live_loop :ambience_piano do
  sample :ambi_piano, amp: 0.6
  sleep 1
end

sleep 4
live_loop :melody do
  3.times do
    3.times do
      melody1
    end
    sleep 1
  end
  stop
end

define :melody1 do
  use_synth :piano
  play 60, amp: 0.7
  sleep 0.25
  play 65, amp: 0.7
  sleep 0.25
  play 70, amp: 0.7
  sleep 0.25
  play 75, amp: 0.7
  sleep 0.25
end

# Korte overgang
sleep 4


# Deel 2: nieuwe melodie
live_loop :melody2 do
  play 62, release: 1, amp: 2
  sleep 0.5
  play 69, release: 1, amp: 2
  sleep 0.5
  play 66, release: 1.5, amp: 2
  sleep 1
  play 67, release: 1, amp: 2
  sleep 0.5
  play 69, release: 3, amp: 2
  sleep 2
end

sleep 18

live_loop :melody3 do
  use_synth :hollow
  play 73, amp: 1.3
  sleep 0.5
  play 69, amp: 1.3
  sleep 0.5
  play 71, amp: 1.3
  sleep 0.5
  play 66, amp: 1.3
  sleep 0.5
end


#-- buffer 2
#main2
use_bpm 85


live_loop :melody do
  use_synth :hollow
  2.times do
    play 60, release: 3, amp: 1.2
    sleep 1
    play 64, release: 3, amp: 1.2
    sleep 1
    play 67, release: 4, amp: 1.2
    sleep 1
    play 69, release: 3, amp: 1.2
    sleep 1
  end
  2.times do
    play 67, release: 2, amp: 1.2
    sleep 0.5
    play 71, release: 2, amp: 1.2
    sleep 0.5
    play 69, release: 3, amp: 1.2
    sleep 1
    play 64, release: 3, amp: 1.2
    sleep 2
  end
end

sleep 16

live_loop :drums do
  sample :bd_sone
  sleep 1
  sample :drum_cymbal_closed
  sleep 1
  sample :bd_sone
  sleep 1
  sample :drum_cymbal_closed
  sleep 1
end

sleep 16

live_loop :bass do
  use_synth :fm
  play 36, release: 1.5, amp: 0.7
  sleep 2
  play 43, release: 1.5, amp: 0.7
  sleep 2
end

sleep 4

live_loop :snare do
  sleep 2
  sample :drum_snare_soft
  sleep 2
end
