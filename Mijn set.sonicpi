#-- Sonic Pi Set v1
#-- meta {"current":2,"zooms":[-4,-2,-4,-2,-5,2,2,2,2,2]}
#-- buffer 0
#Main

#-- buffer 1
#Possible synths and samples
use_synth :piano
use_synth :pluck
sample :ambi_choir
sample :ambi_piano
sample :drum_heavy_kick #also other drum samples
use_synth :sc808_bassdrum
use_synth :dark_ambience
sample :loop_amen



#-- buffer 2
#Testing --> not the final song
use_bpm 120

live_loop :drums do
  sample :drum_tom_mid_hard, amp: 0.8
  sleep 1
  sample :drum_snare_hard, amp: 0.8
  sleep 1
  sample :drum_tom_mid_hard, amp: 0.8
  sleep 1
  sample :drum_snare_hard, amp: 0.8
  sleep 1
end


live_loop :bass do
  use_synth :bass_foundation
  play 60
  sleep 0.5
  play 50
  sleep 0.5
  play 60
  sleep 0.5
end

live_loop :melody do
  use_synth :piano
  if one_in(6)
    use_transpose 2
  else
    use_transpose 0
  end
  play_pattern_timed [:c4, :e4, :f4, :g4, :f4, :e4, :f4, :g4, :f4, :e4, :f4], [0.25, 0.25, 0.25, 1.5, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25], release: 0.8
end

live_loop :ambience do
  sleep 0.25
  sample :ambi_piano, rate: 0.5, amp: 0.6
end
