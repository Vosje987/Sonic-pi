#-- Sonic Pi Set v1
#-- meta {"current":1,"zooms":[-4,-2,-1,2,2,2,2,2,2,2]}
#-- buffer 0
use_synth :hollow

3.times do
  play :D3, attack: 2, release: 4, amp: 0.8
  sleep 4
end
#-- buffer 1
#main

use_synth :hollow
with_fx :reverb, mix: 0.7 do
  
  play choose([:D4,:E4]), attack: 4, release: 4, amp: 1.4
  sleep 6
  
  
  play choose([:Fs4,:G4]), attack: 2, release: 4, amp: 1.4
  sleep 6
  
  
  play choose([:A4, :Cs5]), attack: 3, release: 3, amp: 1.4
  sleep 7
  
end




live_loop :drums do
  sample :drum_tom_mid_hard, amp: 0.6
  sleep 1
  sample :drum_snare_hard, amp: 0.6
  sleep 1
  sample :drum_tom_mid_hard, amp: 0.6
  sleep 1
  sample :drum_snare_hard, amp: 0.6
  sleep 1
end


live_loop :ambience_piano do
  sample :ambi_piano, amp: 0.6
  sleep 1
end

sleep 4
live_loop :melody do
  3.times do
    3.times do
      melody1
    end
    sleep 1
  end
  stop
end

define :melody1 do
  use_synth :piano
  play 60, amp: 0.6
  sleep 0.25
  play 65, amp: 0.6
  sleep 0.25
  play 70, amp: 0.6
  sleep 0.25
  play 75, amp: 0.6
  sleep 0.25
end

# Korte overgang
sleep 2


# Deel 2: nieuwe pianomelodie
live_loop :melody2 do
  play 62, release: 1, amp: 2
  sleep 0.5
  play 69, release: 1, amp: 2
  sleep 0.5
  play 66, release: 1.5, amp: 2
  sleep 1
  play 67, release: 1, amp: 2
  sleep 0.5
  play 69, release: 3, amp: 2
  sleep 2
end


# Deel 3: donkere bas die later binnenkomt
sleep 10
# Nieuwe melodie
sleep 8

live_loop :melody3 do
  use_synth :hollow
  
  play 73, amp: 1.2
  sleep 0.5
  play 69, amp: 1.2
  sleep 0.5
  play 71, amp: 1.2
  sleep 0.5
  play 66, amp: 1.2
  sleep 0.5
end

#-- buffer 2
#Testing --> not the final song
use_bpm 120

live_loop :drums do
  sample :drum_tom_mid_hard, amp: 0.8
  sleep 1
  sample :drum_snare_hard, amp: 0.8
  sleep 1
  sample :drum_tom_mid_hard, amp: 0.8
  sleep 1
  sample :drum_snare_hard, amp: 0.8
  sleep 1
end

in_thread do
  live_loop :bass do
    
    sample :drum_bass_hard, amp: 2
    sleep 0.75
    sample :drum_bass_hard, amp: 2
    sleep 0.75
    sample :drum_bass_hard, amp: 2
    sleep 0.75
  end
end

live_loop :melody do
  use_synth :pulse
  if one_in(2)
    if one_in(6)
      use_transpose 2
    else
      use_transpose 0
    end
  else
    use_transpose 1
  end
  play_pattern_timed [:c4, :e4, :f4, :g4, :f4, :e4, :f4, :g4, :f4, :e4, :f4], [0.25, 0.25, 0.25, 1.5, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25], release: 0.8
end

live_loop :ambience do
  sleep 0.2
  sample :ambi_piano,amp: 2.0, rate: 0.5
end
