#-- Sonic Pi Set v1
#-- meta {"current":2,"zooms":[-2,-2,-1,-1,2,2,2,2,2,2]}
#-- buffer 0
#Main

#-- buffer 1
#Possible synths and samples
use_synth :piano
use_synth :pluck
sample :ambi_choir
sample :ambi_piano
sample :drum_heavy_kick #also other drum samples
use_synth :sc808_bassdrum
use_synth :dark_ambience
sample :loop_amen



#-- buffer 2
#Testing --> not the final song
use_bpm 120

live_loop :drums do
  sample :drum_tom_mid_hard, amp: 0.8
  sleep 1
  sample :drum_snare_hard, amp: 0.8
  sleep 1
  sample :drum_tom_mid_hard, amp: 0.8
  sleep 1
  sample :drum_snare_hard, amp: 0.8
  sleep 1
end

in_thread do
  live_loop :bass do
    
    sample :drum_bass_hard, amp: 2
    sleep 0.75
    sample :drum_bass_hard, amp: 2
    sleep 0.75
    sample :drum_bass_hard, amp: 2
    sleep 0.75
  end
end

live_loop :melody do
  use_synth :pulse
  if one_in(2)
    if one_in(6)
      use_transpose 2
    else
      use_transpose 0
    end
  else
    use_transpose 1
  end
  play_pattern_timed [:c4, :e4, :f4, :g4, :f4, :e4, :f4, :g4, :f4, :e4, :f4], [0.25, 0.25, 0.25, 1.5, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25], release: 0.8
end

live_loop :ambience do
  sleep 0.2
  sample :ambi_piano,amp: 2.0, rate: 0.5
end
